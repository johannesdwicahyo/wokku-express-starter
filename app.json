{
  "name": "wokku-express-starter",
  "description": "Bare-bones Express starter for one-click Wokku deploys",
  "keywords": ["express", "nodejs", "wokku"],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "NODE_ENV": {
      "description": "Node environment (production recommended)",
      "value": "production"
    }
  },
  "formation": {
    "web": {
      "quantity": 1
    }
  }
}
